// ProspectScanner — schéma Prisma
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatutScan {
  en_attente
  en_cours
  termine
  erreur
}

enum Plateforme {
  facebook
  instagram
  tiktok
  linkedin
  youtube
  x
  pagesjaunes
  booking
  tripadvisor
  airbnb
  site_web
}

enum Priorite {
  tres_elevee
  elevee
  moyenne
  faible
}

enum StatutSuivi {
  nouveau
  contacte
  sans_reponse
  en_negociation
  converti
  perdu
}

enum TypeDeconnexion {
  manuelle
  inactivite
}

enum TypeEvenementJournal {
  connexion
  activite_suspecte
}

enum TypeCodeVerification {
  reinitialisation_mdp
  changement_mdp
  connexion
}

enum CategorieTechnologie {
  cms
  ecommerce
  crm_marketing
  analytics
  paiement
  autre
}

enum TypeEvenementBusiness {
  depot_comptes
  procedure_collective
  modification
  radiation
  marche_public
  recrutement
}

enum Segment {
  fort_potentiel
  a_developper
  stable
  a_risque
}

model Scan {
  id                            String     @id @default(cuid())
  statut                        StatutScan @default(en_attente)
  secteur                       String
  ville                         String
  rayon_km                      Int
  date_creation                 DateTime   @default(now())
  date_fin                      DateTime?
  nombre_etablissements_trouves Int        @default(0)
  nombre_prospects_qualifies    Int        @default(0)
  erreur_message                String?

  etablissements Etablissement[]

  @@map("scans")
}

model Etablissement {
  id                       String   @id @default(cuid())
  scan_id                  String
  google_place_id          String?  @unique
  nom                      String
  secteur                  String
  ville                    String
  adresse                  String
  telephone                String?
  email                    String?
  siret                    String?
  statut_siret             String?
  nature_juridique         String?
  tranche_effectif_salarie String?
  note_google              Float?
  nombre_avis_google       Int?
  latitude                 Float?
  longitude                Float?
  date_creation            DateTime @default(now())

  // Identification étendue (recherche-entreprises.api.gouv.fr / BODACC)
  forme_juridique          String?
  nom_commercial           String?
  date_creation_entreprise DateTime?
  categorie_entreprise     String?
  tva_intracommunautaire   String?
  nombre_etablissements    Int?
  score_performance_web    Int?
  score_seo_web            Int?
  score_autorite_domaine   Int?

  scan                 Scan                   @relation(fields: [scan_id], references: [id], onDelete: Cascade)
  presences            PresenceEnLigne[]
  prospect             Prospect?
  dirigeants           Dirigeant[]
  donneesFinancieres   DonneeFinanciere[]
  technologies         TechnologieDetectee[]
  evenements           EvenementBusiness[]
  historiqueReputation HistoriqueReputation[]
  produitsEcommerce    ProduitEcommerce[]

  @@map("etablissements")
}

model Dirigeant {
  id                    String  @id @default(cuid())
  etablissement_id      String
  nom                   String?
  prenoms               String?
  qualite               String?
  type_dirigeant        String?
  annee_naissance       String?
  denomination          String?
  siren_personne_morale String?

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id], onDelete: Cascade)

  @@map("dirigeants")
}

model DonneeFinanciere {
  id               String @id @default(cuid())
  etablissement_id String
  annee            String
  chiffre_affaires Int?
  resultat_net     Int?

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id], onDelete: Cascade)

  @@unique([etablissement_id, annee])
  @@map("donnees_financieres")
}

model TechnologieDetectee {
  id               String               @id @default(cuid())
  etablissement_id String
  categorie        CategorieTechnologie
  nom              String
  detecte_le       DateTime             @default(now())

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id], onDelete: Cascade)

  @@unique([etablissement_id, nom])
  @@map("technologies_detectees")
}

model EvenementBusiness {
  id               String                @id @default(cuid())
  etablissement_id String
  type             TypeEvenementBusiness
  date_evenement   DateTime
  titre            String
  description      String?
  source           String
  url              String?

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id], onDelete: Cascade)

  @@index([etablissement_id, date_evenement])
  @@map("evenements_business")
}

model ProduitEcommerce {
  id               String   @id @default(cuid())
  etablissement_id String
  nom              String
  prix             Float?
  devise           String?
  url              String?
  detecte_le       DateTime @default(now())

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id], onDelete: Cascade)

  @@map("produits_ecommerce")
}

model HistoriqueReputation {
  id                 String   @id @default(cuid())
  etablissement_id   String
  date_mesure        DateTime @default(now())
  note_google        Float?
  nombre_avis_google Int?

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id], onDelete: Cascade)

  @@index([etablissement_id, date_mesure])
  @@map("historique_reputation")
}

model PresenceEnLigne {
  id                String     @id @default(cuid())
  etablissement_id  String
  plateforme        Plateforme
  trouve            Boolean    @default(false)
  url               String?
  nombre_abonnes    Int?
  derniere_activite DateTime?
  details           Json?

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id], onDelete: Cascade)

  @@unique([etablissement_id, plateforme])
  @@map("presences_en_ligne")
}

model Prospect {
  id                  String      @id @default(cuid())
  etablissement_id    String      @unique
  score               Int
  priorite            Priorite
  a_site_web          Boolean     @default(false)
  analyse_commerciale String?
  date_calcul         DateTime    @default(now())
  statut_suivi        StatutSuivi @default(nouveau)

  score_croissance    Int?
  score_digital       Int?
  score_technologique Int?
  score_recrutement   Int?
  score_intention     Int?
  segment             Segment?

  etablissement Etablissement @relation(fields: [etablissement_id], references: [id], onDelete: Cascade)

  @@map("prospects")
}

model Utilisateur {
  id                String   @id @default(cuid())
  email             String   @unique
  mot_de_passe_hash String
  est_admin         Boolean  @default(false)
  actif             Boolean  @default(true)
  date_creation     DateTime @default(now())

  journalConnexions JournalConnexion[]
  codesVerification CodeVerification[]

  @@map("utilisateurs")
}

model CodeVerification {
  id             String               @id @default(cuid())
  utilisateur_id String
  code_hash      String
  type           TypeCodeVerification
  expire_a       DateTime
  utilise        Boolean              @default(false)
  tentatives     Int                  @default(0)
  date_creation  DateTime             @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@index([utilisateur_id, type])
  @@map("codes_verification")
}

model JournalConnexion {
  id               String               @id @default(cuid())
  utilisateur_id   String?
  email            String
  adresse_ip       String
  type_evenement   TypeEvenementJournal @default(connexion)
  connecte_a       DateTime             @default(now())
  deconnecte_a     DateTime?
  type_deconnexion TypeDeconnexion?

  utilisateur Utilisateur? @relation(fields: [utilisateur_id], references: [id], onDelete: SetNull)

  @@index([connecte_a])
  @@map("journal_connexions")
}
